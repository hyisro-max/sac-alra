PROJECT_NAME=SAC-ALRA
SACAI_WEB_PORT=3000
# Optional second OpenWebUI instance (openwebui-canary, COMPOSE_PROFILES=canary)
# for testing a new build without touching the primary instance above.
SACAI_CANARY_WEB_PORT=3006
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
SACAI_INTERNAL_TOKEN=replace-with-a-different-long-random-secret
OLLAMA_BASE_URL=http://10.61.247.254:11434
# To show models from both Ollama servers, uncomment this line.
# OLLAMA_BASE_URLS=http://10.61.247.253:11434;http://10.61.247.254:11434
# vLLM's OpenAI-compatible server on this host, alongside Ollama above.
# EMPTY is vLLM's own placeholder key for a server started without
# --api-key; replace it with the real key if this vLLM deployment enforces
# one (check how the vllm serve process on 8004 was actually started).
#
# OpenWebUI Pipelines (ghcr.io/openwebui/pipelines) is also an OpenAI-
# compatible connection, not a separate integration: OpenWebUI detects it's
# a Pipelines server (not a plain model backend) from the "pipeline" field
# in what its own /models response returns, the same connection type as
# vLLM. Combine both on this host with the same semicolon-joined pattern as
# OLLAMA_BASE_URLS; keep OPENAI_API_BASE_URLS/OPENAI_API_KEYS the same
# length and order. 9099 and 0p3n-w3bu! are the pipelines project's own
# published defaults -- confirm the real port/key this container was
# actually started with before trusting them.
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=http://10.61.247.254:8004/v1;http://10.61.247.254:9099
OPENAI_API_KEYS=EMPTY;0p3n-w3bu!
SACAI_MAX_QUEUED_JOBS=100
SACAI_MAX_USER_JOBS=5
SACAI_MAX_INPUT_BYTES=10737418240
SACAI_MAX_SAMPLE_PIXELS=4000000
SACAI_JOB_TIME_LIMIT_SECONDS=3600
SACAI_JOB_SOFT_TIME_LIMIT_SECONDS=3300
SACAI_ISIS_TIME_LIMIT_SECONDS=7200
SACAI_ISIS_SOFT_TIME_LIMIT_SECONDS=6900
SACAI_NOTEBOOK_TIME_LIMIT_SECONDS=4200
SACAI_NOTEBOOK_SOFT_TIME_LIMIT_SECONDS=3900
SACAI_CLEANUP_MIN_AGE_HOURS=168
PLANETIR_CONCURRENCY=2
PLANETIR_CPU_LIMIT=16
PLANETIR_MEMORY_LIMIT=64G
ISIS_CPU_LIMIT=16
ISIS_MEMORY_LIMIT=64G
NOTEBOOK_CONCURRENCY=4
NOTEBOOK_CPU_LIMIT=4
NOTEBOOK_MEMORY_LIMIT=8G
ISISDATA_HOST_PATH=./offline/isisdata
ISIS_INGEST_COMMAND=
ISIS_CALIBRATE_COMMAND=
ISIS_SPICE_COMMAND=
ISIS_PROJECT_COMMAND=
# Lunar DEM generation (ISIS-calibrated stereo pair -> Ames Stereo Pipeline).
# Mission/sensor-agnostic by construction, same as the ISIS_* commands above:
# these are operator-configured command templates, not a hardcoded pipeline.
# ASP_BUNDLE_ADJUST_COMMAND is optional (skipped entirely when empty); the
# other two are required for any lunar_dem job to run. See
# ARCHITECTURE_DECISIONS.md for the {left}/{right}/{prefix}/{output}
# placeholders each stage receives.
ASP_CONCURRENCY=1
ASP_CPU_LIMIT=16
ASP_MEMORY_LIMIT=64G
ASP_BUNDLE_ADJUST_COMMAND=
ASP_STEREO_COMMAND=
ASP_POINT2DEM_COMMAND=
# Orfeo ToolBox post-processing (e.g. orthorectifying an image against a DEM
# a lunar_dem job produced). Also operator-configured, also optional to use
# at all -- leave OTB_POSTPROCESS_COMMAND empty to disable this stage.
OTB_CONCURRENCY=1
OTB_CPU_LIMIT=8
OTB_MEMORY_LIMIT=32G
OTB_POSTPROCESS_COMMAND=
# Chandrayaan-2 TMC-2, opt-in only (COMPOSE_PROFILES=ch2): a separate ISIS 10
# RC2 stack and ISISDATA tree for the one mission the generic isis-worker
# (ISIS 8.3.0) cannot ingest. Leave unset unless a job explicitly sets
# options.mission="ch2_tmc2".
ISISDATA_CH2_HOST_PATH=./offline/isisdata-ch2
CH2_ISIS_INGEST_COMMAND=
CH2_ISIS_CALIBRATE_COMMAND=
CH2_ISIS_SPICE_COMMAND=
CH2_ISIS_PROJECT_COMMAND=
# Standalone super-resolution (SR4RS-based, sacai-super-res image), opt-in
# only (COMPOSE_PROFILES=superres). Not chained into DEM generation -- an
# on-demand Tool for any image. SUPERRES_COMMAND is the operator's full
# sr.py invocation (savedmodel path, tile size, padding all included in the
# command itself); leave empty to disable this stage.
SUPERRES_CONCURRENCY=1
SUPERRES_CPU_LIMIT=8
SUPERRES_MEMORY_LIMIT=32G
SUPERRES_COMMAND=
# Bind-mounted host paths for scientific outputs, the audit trail, and
# installed tool versions. Run scripts/prepare_output_host_paths.sh after
# editing these (and scripts/migrate_named_volumes_to_bind_mounts.sh first if
# this host previously ran a release using the old named volumes).
SACAI_OUTPUT_HOST_PATH=./offline/data/outputs
SACAI_AUDIT_HOST_PATH=./offline/data/audit
SACAI_TOOL_VERSIONS_HOST_PATH=./offline/data/tool_versions
