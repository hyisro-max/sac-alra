PROJECT_NAME=SAC-ALRA
SACAI_WEB_PORT=3000
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
SACAI_INTERNAL_TOKEN=replace-with-a-different-long-random-secret
OLLAMA_BASE_URL=http://10.61.247.254:11434
# Optional: expose both existing Ollama servers in each OpenWebUI instance.
# OLLAMA_BASE_URLS=http://10.61.247.253:11434;http://10.61.247.254:11434
# vLLM (or any other OpenAI-compatible server) connects the same way Ollama
# does: as an existing external service, never as a Compose service. Leave
# ENABLE_OPENAI_API=false and the two lines below unset/commented until a
# server is actually running, otherwise OpenWebUI falls back to the public
# OpenAI API, which is unreachable from an offline host.
ENABLE_OPENAI_API=false
# OPENAI_API_BASE_URLS=http://10.61.247.254:8004/v1
# EMPTY is vLLM's own placeholder key for a server started without --api-key;
# replace it if the vLLM deployment enforces a real key.
# OPENAI_API_KEYS=EMPTY
# Multiple OpenAI-compatible endpoints (e.g. vLLM on both servers) use the
# same semicolon-joined pattern as OLLAMA_BASE_URLS; keep both lists the same
# length and order.
# OPENAI_API_BASE_URLS=http://10.61.247.253:8004/v1;http://10.61.247.254:8004/v1
# OPENAI_API_KEYS=EMPTY;EMPTY
SACAI_MAX_QUEUED_JOBS=100
SACAI_MAX_USER_JOBS=5
SACAI_MAX_INPUT_BYTES=10737418240
SACAI_MAX_SAMPLE_PIXELS=4000000
SACAI_JOB_TIME_LIMIT_SECONDS=3600
SACAI_JOB_SOFT_TIME_LIMIT_SECONDS=3300
SACAI_ISIS_TIME_LIMIT_SECONDS=7200
SACAI_ISIS_SOFT_TIME_LIMIT_SECONDS=6900
SACAI_NOTEBOOK_TIME_LIMIT_SECONDS=4200
SACAI_NOTEBOOK_SOFT_TIME_LIMIT_SECONDS=3900
SACAI_CLEANUP_MIN_AGE_HOURS=168
PLANETIR_CONCURRENCY=2
PLANETIR_CPU_LIMIT=16
PLANETIR_MEMORY_LIMIT=64G
ISIS_CPU_LIMIT=16
ISIS_MEMORY_LIMIT=64G
NOTEBOOK_CONCURRENCY=4
NOTEBOOK_CPU_LIMIT=4
NOTEBOOK_MEMORY_LIMIT=8G
ISISDATA_HOST_PATH=./offline/isisdata
ISIS_INGEST_COMMAND=
ISIS_CALIBRATE_COMMAND=
ISIS_SPICE_COMMAND=
ISIS_PROJECT_COMMAND=
# Scientific outputs, the audit trail, and installed tool versions are
# bind-mounted to plain host directories (not Docker named volumes) so an
# operator can browse or back them up directly. Run
# scripts/prepare_output_host_paths.sh after editing these. If this host
# previously ran a release that used the sacai-outputs / sacai-audit /
# sacai-tool-versions named volumes, run
# scripts/migrate_named_volumes_to_bind_mounts.sh first.
SACAI_OUTPUT_HOST_PATH=./offline/data/outputs
SACAI_AUDIT_HOST_PATH=./offline/data/audit
SACAI_TOOL_VERSIONS_HOST_PATH=./offline/data/tool_versions
